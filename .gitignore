# Rust
/target/

# Flutter / Dart
/app/.dart_tool/
/app/build/
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/app/.packages
/app/pubspec.lock
# Platform folders are generated by `flutter create` on first bootstrap
# (scripts/bootstrap.sh) and committed afterwards by the developer.
/app/android/
/app/ios/
/app/linux/
/app/macos/
/app/windows/
/app/web/

# Generated FRB bindings (regenerated by `flutter_rust_bridge_codegen generate`)
/app/lib/src/rust/

# Generated l10n Dart (regenerated by flutter pub get — sources are the .arb files)
/app/lib/l10n/app_localizations*.dart

# OS / editor
.DS_Store
*.iml
.idea/
.vscode/

# APK download output of scripts/gh-apk.sh (doc 09 s8) — never commit
/dist/
