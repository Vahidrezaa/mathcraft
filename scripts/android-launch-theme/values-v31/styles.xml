<?xml version="1.0" encoding="utf-8"?>
<!-- اسپلش Android 12+ (API 31) — windowSplashScreenBackground باید همان
     توکن تیره CDS باشد؛ آیکون انیمیت‌دار پیش‌فرض (آیکون اپ) باقی می‌ماند. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/mc_launch_background</item>
    </style>
</resources>
